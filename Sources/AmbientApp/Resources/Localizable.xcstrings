    "Movie / Anime mode (work card, cast on screen)": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画・アニメモード（作品カード、画面上のキャスト）"
