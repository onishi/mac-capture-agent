            "value": "稼働中"
          }
        }
      }
    },
    "Screen Recording permission is required to start.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始するには画面収録の許可が必要です。"
          }
        }
      }
    },
    "Screen Recording permission required": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録の許可が必要です"
          }
        }
      }
    },
    "Screen access": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面へのアクセス"
          }
        }
      }
    },
    "Screen content is processed in memory on this Mac. Screen images are never saved. Nothing is ever sent over the network.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の内容はこの Mac のメモリ上で処理します。画面画像は保存しません。ネットワークには何も送りません。"
          }
        }
      }
    },
    "Screen sharing": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面共有"
          }
        }
      }
    },
    "Settings…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定…"
          }
        }
      }
    },
    "Spoilers": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネタバレ"
          }
        }
      }
    },
    "Start": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始"
          }
        }
      }
    },
    "Starting…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動中…"
          }
        }
      }
    },
    "Stop Translating %@": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を翻訳しない"
          }
        }
      }
    },
    "Stopped": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止中"
          }
        }
      }
    },
    "Technical terms": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専門用語"
          }
        }
      }
    },
    "The archive has no record that answers this.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この質問に答えられる記録はアーカイブにありません。"
          }
        }
      }
    },
    "To see what you see, the app needs Screen Recording permission. Frames stay in memory and are never saved or uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたと同じ画面を見るために、画面収録の許可が必要です。フレームはメモリ上だけで扱い、保存もアップロードもしません。"
          }
        }
      }
    },
    "Top right corner": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上"
          }
        }
      }
    },
    "Translate into": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳先"
          }
        }
      }
    },
    "Translation": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳"
          }
        }
      }
    },
    "Translation Languages…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳言語…"
          }
        }
      }
    },
    "Translation runs on this Mac with Apple's Translation models. Download the languages you want translated in System Settings › General › Language & Region › Translation Languages.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳は Apple の翻訳モデルを使ってこの Mac 上で行います。翻訳したい言語を「システム設定 › 一般 › 言語と地域 › 翻訳言語」でダウンロードしてください。"
          }
        }
      }
    },
    "Translation runs on-device. Install language models in System Settings › General › Language & Region › Translation Languages.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳はこの Mac 上で行います。言語モデルは「システム設定 › 一般 › 言語と地域 › 翻訳言語」でダウンロードしてください。"
          }
        }
      }
    },
    "Turn each kind of intel on or off. When several could be shown at the same moment, the one higher in this list wins (also when you circle something).": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能ごとにオン・オフを切り替えられます。同時に複数の候補があるときは、このリストで上にあるものが優先されます（丸で囲んだときも同じです）。"
          }
        }
      }
    },
    "Units, time zones and dates (pointer rest)": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単位・時差・日付の換算（ポインタを止めたとき）"
          }
        }
      }
    },
    "Visual memory": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビジュアルメモリ"
          }
        }
      }
    },
    "Want to know about something right now? Hold ⌥ (Option) and circle it with the pointer.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ知りたいものがあれば、⌥（Option）を押しながらポインタで丸く囲んでください。"
          }
        }
      }
    },
    "Warn about secrets while sharing": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面共有中の秘密情報の警告"
          }
        }
      }
    },
    "Welcome Guide…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ようこそガイド…"
          }
        }
      }
    },
    "What code does (pointer rest)": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードの説明（ポインタを止めたとき）"
          }
        }
      }
    },
    "With Apple Intelligence (macOS 26), the app also explains technical terms, errors and code, adds one-line briefings, names your work sessions and filters borderline cards — all on-device.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence（macOS 26）があれば、専門用語・エラー・コードの解説、ひとことメモ、作業セッションの命名、迷うカードの判定も行います。すべて端末内で動きます。"
          }
        }
      }
    },
    "With Apple Intelligence it also guesses what an animal, plant, landmark, dish or product is, who a public figure named on screen is, which film you are watching and the background of a news story. The on-device model cannot see images and knows nothing recent, so these are estimates marked “possibly”.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence があれば、動植物・ランドマーク・料理・製品が何か、画面に名前が出ている著名人が誰か、見ている作品、ニュースの背景も推定します。端末内のモデルは画像を見られず最近の出来事も知らないため、これらは「かもしれません」付きの推定です。"
          }
        }
      }
    },
    "Without it, the app still converts units where the pointer rests, expands abbreviations defined earlier on screen and gives hints for common errors.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence がなくても、ポインタを置いたところの単位換算、以前に画面で定義された略語の展開、よくあるエラーのヒントは使えます。"
          }
        }
      }
    },
    "Work card (movie, anime)": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品カード（映画・アニメ）"
          }
        }
      }
    },
    "Work cards and news backgrounds come from the on-device model’s own knowledge (well-known works only; it does not know recent news). News mode also lists related pages you read earlier. Both need “Remember pages you read”. “Up to where I am” uses the episode number in the title; without one it behaves like “No spoilers”.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品カードとニュースの背景は、端末内のモデルが持つ知識から作ります（有名な作品のみ。最近のニュースは知りません）。ニュースモードでは以前に読んだ関連ページも表示します。どちらも「読んだページを記録する」が必要です。「見ているところまで」はタイトルの話数を使い、話数がなければ「ネタバレなし」と同じ動作になります。"
          }
        }
      }
    },
    "“What is this?” for circled text": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸で囲んだ文章の「これは何？」"
          }
        }
      }
    },
    "• Only what a card showed, plus page titles and URLs (if enabled), is archived — on this Mac, excluded from backups, deletable at any time.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 記録するのはカードに表示した内容と、（オンの場合）ページのタイトルと URL だけです。この Mac の中に保存し、バックアップから除外され、いつでも消去できます。"
          }
        }
      }
    },
    "• Password managers, Messages and Photos are excluded; you can add more apps.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• パスワード管理アプリ・メッセージ・写真は除外済みです。除外するアプリは追加できます。"
          }
        }
      }
    },
    "• Pause any time from the menu bar, for 5 minutes, 30 minutes or until tomorrow.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• メニューバーからいつでも一時停止できます（5 分・30 分・明日まで）。"
          }
        }
      }
    },
    "• Screen images are never written to disk.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 画面画像はディスクに保存しません。"
          }
        }
      }
    },
    "◢ FIELD MANUAL": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "◢ FIELD MANUAL"
          }
        }
      }
    }
  },
  "version": "1.0"
}
